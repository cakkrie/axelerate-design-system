{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/data/**",
              "components/display/**",
              "components/feedback/**",
              "components/illustration/**",
              "components/inputs/**",
              "components/navigation/**",
              "components/paper/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Lacquer|Instrument Sans|Gabarito))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Lacquer, Instrument Sans, Gabarito."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|tilt|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, tilt, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|success|warning|danger|neutral|pink|coral|orange|yellow|lime|teal|cyan|navy|lilac)$/]",
        "message": "<Badge> tone must be one of 'brand' | 'success' | 'warning' | 'danger' | 'neutral' | 'pink' | 'coral' | 'orange' | 'yellow' | 'lime' | 'teal' | 'cyan' | 'navy' | 'lilac'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|tail|who|tilt|children|key|ref|className|style|children)$/]",
        "message": "<Bubble> doesn't accept that prop. Declared props: tone, tail, who, tilt, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|ink|violet|pink|coral|orange|yellow|lime|teal|cyan|navy|lilac)$/]",
        "message": "<Bubble> tone must be one of 'paper' | 'ink' | 'violet' | 'pink' | 'coral' | 'orange' | 'yellow' | 'lime' | 'teal' | 'cyan' | 'navy' | 'lilac'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Bubble'] > JSXAttribute[name.name='tail'] > Literal[value!=/^(?:bl|br|tl|tr)$/]",
        "message": "<Bubble> tail must be one of 'bl' | 'br' | 'tl' | 'tr'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|disabled|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, disabled, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|yellow|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'yellow' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|padding|tint|tilt|punch|scribble|interactive|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, padding, tint, tilt, punch, scribble, interactive, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:sheet|quiet|tint|ink|sketch|tall|default|elevated|outline|inverse|paper)$/]",
        "message": "<Card> variant must be one of 'sheet' | 'quiet' | 'tint' | 'ink' | 'sketch' | 'tall' | 'default' | 'elevated' | 'outline' | 'inverse' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:none|sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'none' | 'sm' | 'md' | 'lg'."
